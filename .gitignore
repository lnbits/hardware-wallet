.vscode
__pycache__/
*.pyc
/build/
/firmware-build/
/built-firmware/
/installer/firmware/esp32/current/*/

# TFT_eSPI is vendored as Arduino runtime source only. Keep upstream examples,
# documentation, CI files, and tooling out of firmware commits.
/libraries/TFT_eSPI/.gitattributes
/libraries/TFT_eSPI/.github/
/libraries/TFT_eSPI/.gitignore
/libraries/TFT_eSPI/CMakeLists.txt
/libraries/TFT_eSPI/Kconfig
/libraries/TFT_eSPI/README.md
/libraries/TFT_eSPI/README.txt
/libraries/TFT_eSPI/TFT_config.h
/libraries/TFT_eSPI/Tools/
/libraries/TFT_eSPI/docs/
/libraries/TFT_eSPI/examples/
/libraries/TFT_eSPI/library.json
/libraries/TFT_eSPI/other stuff/

# Arduino_GFX is vendored as runtime source only (QSPI + RM67162 subset).
/libraries/Arduino_GFX/.gitattributes
/libraries/Arduino_GFX/.github/
/libraries/Arduino_GFX/.gitignore
/libraries/Arduino_GFX/README.md
/libraries/Arduino_GFX/gen_keywords.pl
/libraries/Arduino_GFX/keywords.txt
/libraries/Arduino_GFX/license.txt
/libraries/Arduino_GFX/examples/
